<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<?import javafx.scene.canvas.Canvas?>

<BorderPane xmlns="http://javafx.com/javafx"
            stylesheets="@../css/styles.css"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.tsplviewer.controller.AppController"
            prefHeight="700.0" prefWidth="1200.0">

    <center>
        <SplitPane>

            <VBox styleClass="tspl-code">
                <Label text="TSPL Code"/>
                <Separator />

                <TextArea fx:id="tsplTextArea"/>
            </VBox>

            <VBox styleClass="label-preview">
                <Label text="Label Preview"/>
                <Separator />

                <StackPane VBox.vgrow="ALWAYS">
                    <Canvas fx:id="previewCanvas" height="600" width="600"/>
                </StackPane>
            </VBox>

            <VBox styleClass="settings">
                <Label text="Print Settings"/>
                <Separator />

                <GridPane fx:id="settingsGrid" />
<!--                <VBox>-->
<!--                    <Label text="Variables" styleClass="variables"/>-->
<!--                    <Separator />-->

<!--                    <GridPane fx:id="variableGrid">-->
<!--                    </GridPane>-->
<!--                </VBox>-->
            </VBox>

        </SplitPane>
    </center>

    <bottom>
        <VBox spacing="5" styleClass="footer">
            <TextArea fx:id="validationArea" prefHeight="100" editable="false" />
        </VBox>
    </bottom>

</BorderPane>
